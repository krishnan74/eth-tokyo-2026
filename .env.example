# Sepolia RPC. Any public endpoint works.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Operator: deploys, owns acme-corp.eth, admins TeamRegistry. Needs Sepolia ETH and MockUSDC (public mint on the beta deployment). With or without 0x.
OPERATOR_PRIVATE_KEY=
# Outsider: the account that is denied, joins the team, and is denied again. Any fresh key; demo.ts funds it from the operator.
OUTSIDER_PRIVATE_KEY=
