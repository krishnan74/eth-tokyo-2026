{
  "name": "cascade",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "forge build",
    "test": "forge test -vv",
    "setup": "tsx --env-file=.env scripts/setup.ts",
    "demo": "tsx --env-file=.env scripts/demo.ts",
    "gen": "tsx scripts/gen-core.ts",
    "ui": "next dev web",
    "ui:build": "next build web",
    "ui:start": "next start web",
    "setup:v2": "tsx --env-file=.env scripts/setup-v2.ts",
    "smoke:v2": "tsx --env-file=.env scripts/smoke-v2.ts",
    "test:fork": "FORK_TESTS=1 forge test --match-contract RosterForkTest -vv",
    "prove": "forge build --ast && halmos --contract CascadeSymbolicTest --loop 4 --solver-timeout-assertion 0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.3",
    "cli-table3": "^0.6.5",
    "framer-motion": "^13.4.4",
    "lenis": "^1.3.26",
    "next": "^16.3.6",
    "picocolors": "^1.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "viem": "^2.56.9",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
